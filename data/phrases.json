[
  { "id": "p-konnichiwa", "kana": "こんにちは。", "kanji": null, "romaji": "Konnichiwa.", "en": "Hello. / Good afternoon.", "category": "Basics", "note": "The last は is read \"wa\"." },
  { "id": "p-ohayo", "kana": "おはよう ございます。", "kanji": null, "romaji": "Ohayō gozaimasu.", "en": "Good morning.", "category": "Basics", "note": null },
  { "id": "p-konbanwa", "kana": "こんばんは。", "kanji": null, "romaji": "Konbanwa.", "en": "Good evening.", "category": "Basics", "note": null },
  { "id": "p-arigato", "kana": "ありがとう ございます。", "kanji": null, "romaji": "Arigatō gozaimasu.", "en": "Thank you very much.", "category": "Basics", "note": null },
  { "id": "p-sumimasen", "kana": "すみません。", "kanji": null, "romaji": "Sumimasen.", "en": "Excuse me. / I'm sorry.", "category": "Basics", "note": "The most useful word: to get attention, to apologize, even to say thanks." },
  { "id": "p-gomennasai", "kana": "ごめんなさい。", "kanji": null, "romaji": "Gomen nasai.", "en": "I'm sorry.", "category": "Basics", "note": null },
  { "id": "p-hajimemashite", "kana": "はじめまして。", "kanji": "初めまして。", "romaji": "Hajimemashite.", "en": "Nice to meet you.", "category": "Basics", "note": "Said the first time you meet someone." },
  { "id": "p-philippines", "kana": "わたしは フィリピンから きました。", "kanji": "私はフィリピンから来ました。", "romaji": "Watashi wa Firipin kara kimashita.", "en": "I'm from the Philippines.", "category": "Basics", "note": null },
  { "id": "p-sukoshi", "kana": "にほんごが すこし わかります。", "kanji": "日本語が少し分かります。", "romaji": "Nihongo ga sukoshi wakarimasu.", "en": "I understand a little Japanese.", "category": "Basics", "note": null },
  { "id": "p-wakarimasen", "kana": "わかりません。", "kanji": "分かりません。", "romaji": "Wakarimasen.", "en": "I don't understand.", "category": "Basics", "note": null },
  { "id": "p-eigo", "kana": "えいごを はなせますか。", "kanji": "英語を話せますか。", "romaji": "Eigo o hanasemasu ka.", "en": "Can you speak English?", "category": "Basics", "note": null },
  { "id": "p-moichido", "kana": "もう いちど おねがいします。", "kanji": "もう一度お願いします。", "romaji": "Mō ichido onegai shimasu.", "en": "One more time, please.", "category": "Basics", "note": null },
  { "id": "p-yukkuri", "kana": "ゆっくり はなして ください。", "kanji": "ゆっくり話してください。", "romaji": "Yukkuri hanashite kudasai.", "en": "Please speak slowly.", "category": "Basics", "note": null },
  { "id": "p-daijobu", "kana": "だいじょうぶです。", "kanji": "大丈夫です。", "romaji": "Daijōbu desu.", "en": "I'm OK. / No, thank you.", "category": "Basics", "note": "A polite way to say no, e.g. when offered a bag." },

  { "id": "p-eki-doko", "kana": "えきは どこですか。", "kanji": "駅はどこですか。", "romaji": "Eki wa doko desu ka.", "en": "Where is the station?", "category": "Getting around", "note": "Swap えき for any place: トイレは どこですか。" },
  { "id": "p-toire-doko", "kana": "トイレは どこですか。", "kanji": null, "romaji": "Toire wa doko desu ka.", "en": "Where is the restroom?", "category": "Getting around", "note": null },
  { "id": "p-made-ikura", "kana": "おおさかじょうまで いくらですか。", "kanji": "大阪城までいくらですか。", "romaji": "Ōsakajō made ikura desu ka.", "en": "How much is it to Osaka Castle?", "category": "Getting around", "note": "Swap the place name: 〇〇まで いくらですか (to 〇〇)." },
  { "id": "p-umeda", "kana": "この でんしゃは うめだに いきますか。", "kanji": "この電車は梅田に行きますか。", "romaji": "Kono densha wa Umeda ni ikimasu ka.", "en": "Does this train go to Umeda?", "category": "Getting around", "note": "Umeda is Osaka's big station area (Osaka Station)." },
  { "id": "p-dono-sen", "kana": "どの せんに のれば いいですか。", "kanji": "どの線に乗ればいいですか。", "romaji": "Dono sen ni noreba ii desu ka.", "en": "Which line should I take?", "category": "Getting around", "note": null },
  { "id": "p-koko-ikitai", "kana": "ここへ いきたいです。", "kanji": "ここへ行きたいです。", "romaji": "Koko e ikitai desu.", "en": "I want to go here.", "category": "Getting around", "note": "Show a map or address while you say it." },
  { "id": "p-oroshite", "kana": "ここで おろして ください。", "kanji": "ここで降ろしてください。", "romaji": "Koko de oroshite kudasai.", "en": "Please let me off here.", "category": "Getting around", "note": "For taxis." },
  { "id": "p-aruite", "kana": "あるいて いけますか。", "kanji": "歩いて行けますか。", "romaji": "Aruite ikemasu ka.", "en": "Can I walk there?", "category": "Getting around", "note": null },
  { "id": "p-mayoimashita", "kana": "みちに まよいました。", "kanji": "道に迷いました。", "romaji": "Michi ni mayoimashita.", "en": "I'm lost.", "category": "Getting around", "note": null },

  { "id": "p-yoyaku", "kana": "よやく して います。", "kanji": "予約しています。", "romaji": "Yoyaku shite imasu.", "en": "I have a reservation.", "category": "Hotel", "note": null },
  { "id": "p-checkin", "kana": "チェックインを おねがいします。", "kanji": "チェックインをお願いします。", "romaji": "Chekkuin o onegai shimasu.", "en": "Check-in, please.", "category": "Hotel", "note": null },
  { "id": "p-nimotsu", "kana": "にもつを あずけても いいですか。", "kanji": "荷物を預けてもいいですか。", "romaji": "Nimotsu o azukete mo ii desu ka.", "en": "Can I leave my luggage here?", "category": "Hotel", "note": "Useful before check-in or after check-out." },
  { "id": "p-wifi", "kana": "ワイファイの パスワードは なんですか。", "kanji": "Wi-Fiのパスワードは何ですか。", "romaji": "Waifai no pasuwādo wa nan desu ka.", "en": "What's the Wi-Fi password?", "category": "Hotel", "note": null },

  { "id": "p-futari", "kana": "ふたりです。", "kanji": "二人です。", "romaji": "Futari desu.", "en": "Two people.", "category": "Food", "note": "Answer when staff ask how many. One person: ひとりです (hitori desu). Holding up fingers works too." },
  { "id": "p-menyu", "kana": "メニューを ください。", "kanji": null, "romaji": "Menyū o kudasai.", "en": "The menu, please.", "category": "Food", "note": null },
  { "id": "p-eigo-menyu", "kana": "えいごの メニューは ありますか。", "kanji": "英語のメニューはありますか。", "romaji": "Eigo no menyū wa arimasu ka.", "en": "Do you have an English menu?", "category": "Food", "note": null },
  { "id": "p-kore-kudasai", "kana": "これを ください。", "kanji": null, "romaji": "Kore o kudasai.", "en": "This one, please.", "category": "Food", "note": "Point at the menu or the item." },
  { "id": "p-osusume", "kana": "おすすめは なんですか。", "kanji": "おすすめは何ですか。", "romaji": "Osusume wa nan desu ka.", "en": "What do you recommend?", "category": "Food", "note": null },
  { "id": "p-mizu", "kana": "みずを ください。", "kanji": "水をください。", "romaji": "Mizu o kudasai.", "en": "Water, please.", "category": "Food", "note": null },
  { "id": "p-itadakimasu", "kana": "いただきます。", "kanji": null, "romaji": "Itadakimasu.", "en": "(said before eating)", "category": "Food", "note": "Like saying grace or \"let's eat\"; Japanese people say it before every meal." },
  { "id": "p-gochisosama", "kana": "ごちそうさまでした。", "kanji": null, "romaji": "Gochisōsama deshita.", "en": "Thank you for the meal. (said after eating)", "category": "Food", "note": "Say it to the staff as you leave a restaurant." },
  { "id": "p-oishii", "kana": "おいしいです。", "kanji": "美味しいです。", "romaji": "Oishii desu.", "en": "It's delicious.", "category": "Food", "note": null },
  { "id": "p-okaikei", "kana": "おかいけいを おねがいします。", "kanji": "お会計をお願いします。", "romaji": "Okaikei o onegai shimasu.", "en": "The bill, please.", "category": "Food", "note": null },
  { "id": "p-ebi", "kana": "えびが たべられません。", "kanji": "えびが食べられません。", "romaji": "Ebi ga taberaremasen.", "en": "I can't eat shrimp.", "category": "Food", "note": "For allergies: swap えび (shrimp) for the food, e.g. ぎゅうにゅう (milk), たまご (egg)." },

  { "id": "p-ikura", "kana": "いくらですか。", "kanji": null, "romaji": "Ikura desu ka.", "en": "How much is it?", "category": "Shopping", "note": null },
  { "id": "p-kado", "kana": "カードで はらえますか。", "kanji": "カードで払えますか。", "romaji": "Kādo de haraemasu ka.", "en": "Can I pay by card?", "category": "Shopping", "note": null },
  { "id": "p-fukuro", "kana": "ふくろは いりません。", "kanji": "袋はいりません。", "romaji": "Fukuro wa irimasen.", "en": "I don't need a bag.", "category": "Shopping", "note": null },
  { "id": "p-miteru", "kana": "みて いる だけです。", "kanji": "見ているだけです。", "romaji": "Mite iru dake desu.", "en": "I'm just looking.", "category": "Shopping", "note": null },
  { "id": "p-shichaku", "kana": "しちゃく しても いいですか。", "kanji": "試着してもいいですか。", "romaji": "Shichaku shite mo ii desu ka.", "en": "May I try it on?", "category": "Shopping", "note": null },
  { "id": "p-menzei", "kana": "めんぜいで かえますか。", "kanji": "免税で買えますか。", "romaji": "Menzei de kaemasu ka.", "en": "Can I buy this tax-free?", "category": "Shopping", "note": "Tourists can shop tax-free at many stores; bring your passport." },

  { "id": "p-tasukete", "kana": "たすけて ください。", "kanji": "助けてください。", "romaji": "Tasukete kudasai.", "en": "Please help me.", "category": "Emergency", "note": null },
  { "id": "p-byoin", "kana": "びょういんへ つれて いって ください。", "kanji": "病院へ連れて行ってください。", "romaji": "Byōin e tsurete itte kudasai.", "en": "Please take me to a hospital.", "category": "Emergency", "note": null },
  { "id": "p-saifu", "kana": "さいふを なくしました。", "kanji": "財布をなくしました。", "romaji": "Saifu o nakushimashita.", "en": "I lost my wallet.", "category": "Emergency", "note": "Go to a こうばん (police box); lost wallets are often returned in Japan." },
  { "id": "p-kyukyusha", "kana": "きゅうきゅうしゃを よんで ください。", "kanji": "救急車を呼んでください。", "romaji": "Kyūkyūsha o yonde kudasai.", "en": "Please call an ambulance.", "category": "Emergency", "note": "Ambulance number: 119." },
  { "id": "p-shashin", "kana": "しゃしんを とって もらえますか。", "kanji": "写真を撮ってもらえますか。", "romaji": "Shashin o totte moraemasu ka.", "en": "Could you take a photo for me?", "category": "Basics", "note": null },
  { "id": "p-okini", "kana": "おおきに。", "kanji": null, "romaji": "Ōkini.", "en": "Thank you. (Osaka dialect)", "category": "Basics", "note": "Osaka's friendly \"thanks\". Shopkeepers say it a lot; locals will smile if you say it back." }
